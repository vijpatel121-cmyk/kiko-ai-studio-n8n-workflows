    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst base = $('Normalize Image Request').first().json;\nconst payload = raw.structuredContent ?? raw.content?.find(x => x.type === 'text')?.text ?? raw;\nfunction find(o, names) {\n  if (!o || typeof o !== 'object') return undefined;\n  for (const [k, v] of Object.entries(o)) {\n    if (names.includes(k) && typeof v === 'string' && v) return v;\n  }\n  for (const v of Object.values(o)) {\n    const hit = find(v, names);\n    if (hit) return hit;\n  }\n}\nconst generation_id = find(payload, ['generation_id', 'generationId']);\nif (!generation_id) throw new Error('Kling image submission did not return generation_id');\nreturn [{\n  json: {\n    provider: 'kling_mcp',\n    asset_type: 'image',\n    episode_id: base.episode_id,\n    scene: base.scene,\n    narration: base.narration,\n    narration_en: base.narration_en,\n    sfx_cue: base.sfx_cue,\n    prompt: base.prompt,\n    image_prompt: base.image_prompt,\n    original_prompt: base.original_prompt,\n    base_image_prompt: base.base_image_prompt,\n    optimized_image_prompt: base.optimized_image_prompt,\n    generation_id,\n    task_trace_id: base.task_trace_id,\n    status: 'submitted',\n    submitted_at: new Date().toISOString(),\n  },\n}];"
      },
