    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nif (!d.episode_id) {\n  throw new Error('episode_id is required');\n}\n\nif (!Number.isInteger(Number(d.scene)) || Number(d.scene) < 1) {\n  throw new Error('scene must be a positive integer');\n}\n\nif (typeof d.prompt !== 'string' || !d.prompt.trim()) {\n  throw new Error('prompt is required');\n}\n\nconst prompt = d.prompt.trim();\nconst originalPrompt =\n  typeof d.original_prompt === 'string' && d.original_prompt.trim()\n    ? d.original_prompt.trim()\n    : typeof d.base_image_prompt === 'string' && d.base_image_prompt.trim()\n      ? d.base_image_prompt.trim()\n      : prompt;\nconst optimizedPrompt =\n  typeof d.optimized_image_prompt === 'string' && d.optimized_image_prompt.trim()\n    ? d.optimized_image_prompt.trim()\n    : prompt;\n\nconst refs = Array.isArray(d.reference_urls)\n  ? d.reference_urls.filter(Boolean)\n  : [];\n\nif (refs.length > 10) {\n  throw new Error('reference_urls supports at most 10 images');\n}\n\nfor (const url of refs) {\n  if (!/^https:\\/\\//i.test(url)) {\n    throw new Error('Every reference_urls item must be an HTTPS Kling/upload URL');\n  }\n}\n\nconst trace =\n  d.task_trace_id ||\n  (() => {\n    const ts = Date.now().toString(16).padStart(12, '0');\n    const r = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 16).toString(16)).join('');\n    return `${ts.slice(0, 8)}-${ts.slice(8)}-7${r(3)}-${['8', '9', 'a', 'b'][Math.floor(Math.random() * 4)]}${r(3)}-${r(12)}`;\n  })();\n\nconst model = d.model || 'kling-image-v3_0_omni';\nconst aspectRatio = d.aspect_ratio || '16:9';\nconst resolution = d.img_resolution || '1k';\nconst imageCount = Number(d.image_count || 1);\nconst klingTool = refs.length ? 'image_to_image' : 'text_to_image';\n\nconst mcpRequest = {\n  prompt,\n  model,\n  aspect_ratio: aspectRatio,\n  resolution,\n  image_count: imageCount,\n  task_trace_id: trace,\n};\n\nif (refs.length) {\n  mcpRequest.reference_urls = refs;\n}\n\nreturn [{\n  json: {\n    ...d,\n    scene: Number(d.scene),\n    prompt,\n    original_prompt: originalPrompt,\n    base_image_prompt: originalPrompt,\n    optimized_image_prompt: optimizedPrompt,\n    image_prompt: prompt,\n    image_count: imageCount,\n    provider: 'kling_mcp',\n    kling_tool: klingTool,\n    task_trace_id: trace,\n    mcp_request: mcpRequest,\n  },\n}];"
      },
