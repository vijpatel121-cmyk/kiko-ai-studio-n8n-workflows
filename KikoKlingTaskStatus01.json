    {
      "parameters": {
        "jsCode": "const raw=$input.first().json;const base=$('Normalize Status Request').first().json;const payload=raw.structuredContent ?? raw.content?.find(x=>x.type==='text')?.text ?? raw;\nconst statuses=[];const urls=[];function walk(v,k=''){if(typeof v==='string'){if(['status','state','task_status','taskStatus'].includes(k))statuses.push(v);if(/^https:\\/\\//i.test(v))urls.push(v);return;}if(Array.isArray(v)){for(const x of v)walk(x,k);return;}if(v&&typeof v==='object'){for(const [key,val] of Object.entries(v))walk(val,key);}}walk(payload);\nconst status=(statuses[0]||'unknown').toLowerCase();const done=['success','succeeded','completed','complete','finished'].some(x=>status.includes(x));const failed=['failed','error','cancelled','canceled','rejected'].some(x=>status.includes(x));\nreturn [{json:{provider:'kling_mcp',generation_id:base.generation_id,task_trace_id:base.task_trace_id,status,done,failed,result_urls:[...new Set(urls)],checked_at:new Date().toISOString(),raw:payload}}];"
      },
