        "jsCode": "const trigger = $input.first().json;\nreturn trigger.dialogue_lines.map((line, index) => ({\n  json: {\n    episode_id: trigger.episode_id,\n    scene: Number(trigger.scene),\n    speaker: line.speaker,\n    text: line.text,\n    text_en: line.text_en,\n    line_type: line.line_type,\n    line_index: index,\n  },\n}));"
      },
