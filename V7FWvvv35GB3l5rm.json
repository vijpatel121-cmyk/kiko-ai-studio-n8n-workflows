    {
      "parameters": {
        "jsCode": "const readJson = (nodeName, property) => JSON.parse(Buffer.from($(nodeName).first().binary[property].data, 'base64').toString('utf8'));\nconst request = $('Edit Trial Asset Request').first().json;\nconst prompts = readJson('Read Prompt Library', 'prompt_library').prompts;\nconst backgrounds = readJson('Read Background Bible', 'background_bible');\nconst characters = readJson('Read Character Bible', 'character_bible');\nconst type = String(request.asset_type || '').toLowerCase();\nif (!['background', 'character'].includes(type)) throw new Error('asset_type must be background or character');\nconst label = String(request.asset_label || request.asset_id || 'trial-asset').replace(/[^a-z0-9_-]+/gi, '-').replace(/^-+|-+$/g, '').toLowerCase();\nlet prompt;\nlet outputFolder;\nif (type === 'background') {\n  const location = backgrounds.locations.find(x => x.id === request.asset_id);\n  if (!location) throw new Error('Unknown background asset_id: ' + request.asset_id);\n  const time = backgrounds.time_variants[request.time_variant] || backgrounds.time_variants.day;\n  prompt = `${backgrounds.visual_style.rendering}, ${backgrounds.visual_style.lighting}, ${backgrounds.visual_style.composition}. Create a clean reusable background plate only: ${location.purpose}. Locked features: ${location.locked_features.join(', ')}. Time: ${time}. ${prompts.background_lock} ${prompts.image_negative}`;\n  outputFolder = 'C:\\\\Users\\\\pc-11\\\\Desktop\\\\Kiko AI Studio\\\\Assets\\\\images';\n} else {\n  const character = characters.characters.find(x => x.id === request.asset_id);\n  if (!character) throw new Error('Unknown character asset_id: ' + request.asset_id);\n  prompt = `${characters.visual_style.medium}, ${characters.visual_style.rendering}. Create one full-body character turnaround/reference image on a plain soft-cream studio background: ${character.locked_description}. Neutral friendly pose, facing camera, child-safe, no props. ${prompts.character_lock} ${prompts.image_negative}`;\n  outputFolder = 'C:\\\\Users\\\\pc-11\\\\Desktop\\\\Kiko AI Studio\\\\Assets\\\\characters';\n}\nif (String(request.prompt_override || '').trim()) prompt += ` Additional request: ${request.prompt_override.trim()}`;\nconst fileName = `${type}_${label}.png`;\nreturn [{ json: { ...request, generated_prompt: prompt, file_name: fileName, output_path: `${outputFolder}\\\\${fileName}`, asset_trial: true } }];"
      },
